      },
      {
        "article": {},
        "attachments": {},
        "author_id": "1561753484512612353",
        "conversation_id": "2049108607372058783",
        "created_at": "2026-04-28T12:48:57.000Z",
        "edit_controls": {
          "editable_until": "2026-04-28T13:48:57.000Z",
          "edits_remaining": 5,
